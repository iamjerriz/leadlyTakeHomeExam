    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@vercel/node": "^3.2.24",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
